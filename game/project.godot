; Bounded sample scene. Source authored only; no export preset yet.
; No editor/import/runtime/build has been executed for this milestone.
config_version=5

[application]
config/name="Game Runtime Foundation"
run/main_scene="res://scenes/world_explorer.tscn"
config/features=PackedStringArray("4.1", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
