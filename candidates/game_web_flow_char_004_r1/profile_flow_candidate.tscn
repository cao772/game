[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://profile_flow_candidate.gd" id="1_flow"]

[node name="PlaceholderCharacterFlow" type="MarginContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_flow")

[node name="Layout" type="VBoxContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_constants/separation = 10

[node name="Header" type="HFlowContainer" parent="Layout"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Title" type="Label" parent="Layout/Header"]
layout_mode = 2
size_flags_horizontal = 3
text = "占位角色资料"
theme_override_font_sizes/font_size = 20
autowrap_mode = 3

[node name="BackButton" type="Button" parent="Layout/Header"]
layout_mode = 2
text = "返回列表"
disabled = true

[node name="ReloadSamplesButton" type="Button" parent="Layout/Header"]
layout_mode = 2
text = "重载占位"

[node name="ExitButton" type="Button" parent="Layout/Header"]
layout_mode = 2
text = "退出模块"

[node name="Status" type="Label" parent="Layout"]
layout_mode = 2
text = "未装入资料；仅演示合成占位数据"
autowrap_mode = 3

[node name="Breadcrumb" type="Label" parent="Layout"]
layout_mode = 2
text = "占位资料 / 列表"
autowrap_mode = 3

[node name="Search" type="LineEdit" parent="Layout"]
layout_mode = 2
placeholder_text = "按名称或标签筛选"
clear_button_enabled = true
focus_mode = 2

[node name="Body" type="HBoxContainer" parent="Layout"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_constants/separation = 14

[node name="ListSide" type="VBoxContainer" parent="Layout/Body"]
custom_minimum_size = Vector2(0, 0)
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_constants/separation = 8

[node name="ListTitle" type="Label" parent="Layout/Body/ListSide"]
layout_mode = 2
text = "资料列表"
theme_override_font_sizes/font_size = 18

[node name="ResultCount" type="Label" parent="Layout/Body/ListSide"]
layout_mode = 2
text = "显示 0 条"

[node name="ListScroll" type="ScrollContainer" parent="Layout/Body/ListSide"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Rows" type="VBoxContainer" parent="Layout/Body/ListSide/ListScroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 6

[node name="Pagination" type="HBoxContainer" parent="Layout/Body/ListSide"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="PreviousPageButton" type="Button" parent="Layout/Body/ListSide/Pagination"]
layout_mode = 2
