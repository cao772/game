vertical_alignment = 1

[node name="NextPageButton" type="Button" parent="Layout/Body/ListSide/Pagination"]
layout_mode = 2
text = "下一页"
disabled = true
focus_mode = 2

[node name="EmptyList" type="Label" parent="Layout/Body/ListSide"]
layout_mode = 2
text = "暂无占位资料"
autowrap_mode = 3

[node name="DetailSide" type="VBoxContainer" parent="Layout/Body"]
custom_minimum_size = Vector2(0, 0)
